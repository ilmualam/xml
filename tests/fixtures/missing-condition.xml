<?xml version='1.0' encoding='UTF-8'?>
<html xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gml/b'>
  <body>
    <!-- b:if element without required cond attribute -->
    <b:if>
      <div>This block has no condition</div>
    </b:if>
    <!-- Valid b:if for contrast -->
    <b:if cond='data:view.isHomepage'>
      <div>Homepage block</div>
    </b:if>
  </body>
</html>
